# ===== 基础配置 =====
# 宿主机暴露的本地 API / 控制台端口（仅监听 127.0.0.1）
HOST_PORT=8317
# Claude 桌面端映射端口（独立画面地址：http://127.0.0.1:8318/edualc-desktop.html）
DESKTOP_VNC_PORT=8318
# 容器 Web 终端端口
TERMINAL_PORT=8319

# 映射到容器 /workspace 的宿主机项目目录（可改为任意单个项目路径，绝不挂载 ~/.ssh）
WORKSPACE_DIR=./workspace
WORKSPACE_NAME=project

# 虚拟机资源配置（可在 Web 控制台随时修改；Mac Colima / Windows WSL2 通用）
VM_CPU=4
VM_MEMORY_GB=6
VM_DISK_GB=40

# 宿主机客户端调用所需的本地 Key（个人本机使用默认留空免密；如需鉴权可自行填写）
RELAY_API_KEY=

# gateway 与 relay 内部通信令牌
INTERNAL_TOKEN=mini-cage-internal-change-me

# 默认 Claude 模型别名 (sonnet / opus / haiku)
DEFAULT_MODEL=sonnet

# ===== 出口代理配置（可选，也可启动后在 http://127.0.0.1:8317/ui 界面导入）=====
# 方式 1：Clash / Mihomo 订阅链接
SUBSCRIPTION_URL=
# 可选链式代理：前置订阅节点 -> 落地住宅静态代理（例：socks5://user:pass@1.2.3.4:1080）
LANDING_PROXY_URL=

# 方式 2：单个静态代理（若填了 SUBSCRIPTION_URL 则优先用订阅）
UPSTREAM_PROXY=

# ===== 出口风控策略 =====
# dynamic 或 static
EXIT_MODE=dynamic
# dynamic 范围：any（任意支持地区，自动拦截 CN/HK/MO/RU 等）| country | region | city
EXIT_SCOPE=any
# 若 EXIT_SCOPE=country，例如填 US / JP / SG
EXIT_COUNTRY=
# 若 EXIT_MODE=static，填固定公网 IPv4
EXIT_IP=
